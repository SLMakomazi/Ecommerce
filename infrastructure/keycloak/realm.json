{
  "realm": "ecommerce",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "customer"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {},
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "ecommerce-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ecommerce-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@example.test",
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "customer-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "other",
      "enabled": true,
      "email": "other@example.test",
      "emailVerified": true,
      "firstName": "Other",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "other-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "admin-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
